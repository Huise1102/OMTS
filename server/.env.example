# ========== 服务配置 ==========
PORT=3000

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cinema_db

# ========== JWT 密钥（生产环境请更换） ==========
JWT_SECRET=cinema_jwt_secret_2026

# ========== 大模型配置 ==========
# qwen：通义千问云端（默认）；ollama：本地 Ollama
LLM_PROVIDER=qwen
# 请求超时（毫秒）；本地模型在 CPU 上较慢，可设为 120000
LLM_TIMEOUT_MS=30000

# ----- 通义千问（LLM_PROVIDER=qwen 时生效） -----
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ----- 本地 Ollama（LLM_PROVIDER=ollama 时生效） -----
# 使用前先启动服务并拉取支持工具调用的模型（deepseek-r1 不支持工具调用，不要用于助手）：
#   ollama serve
#   ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=ollama